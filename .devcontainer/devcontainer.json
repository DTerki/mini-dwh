{
  "name": "mini-dwh",
  "build": { "dockerfile": "Dockerfile" },
  "mounts": [
    "source=/var/run/docker.sock,target=/var/run/docker.sock,type=bind"
  ],
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-azuretools.vscode-docker",
        "ms-vscode-remote.remote-containers",
        "ms-mssql.mssql"
      ]
    }
  },
  "postCreateCommand": "pip install -r requirements.txt"
}
